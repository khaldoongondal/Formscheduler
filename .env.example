# FormBook environment variables. Placeholders only; never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the app (no trailing slash).
# Production: NEXT_PUBLIC_APP_URL=https://app.formbook.ca
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encrypts stored GoHighLevel tokens (openssl rand -base64 32).
LEADDER_TOKEN_ENCRYPTION_KEY=
# Shared secret for /api/provision (GoHighLevel provisioning workflow).
LEADDER_PROVISION_SECRET=
# GoHighLevel marketplace app (one-click connection).
GHL_OAUTH_CLIENT_ID=
GHL_OAUTH_CLIENT_SECRET=

# Local development only. Must NOT be set in production.
LEADDER_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
LEADDER_DEMO_SLOT_MODE=false

# Salt for hashing visitor IP addresses in rate-limit keys (random, 32+ characters).
FORMBOOK_IP_HASH_SALT=

# Self-serve signup and password reset emails go through GoHighLevel inbound webhooks.
# When unset, Supabase sends its own emails instead.
FORMBOOK_GHL_SIGNUP_WEBHOOK_URL=
FORMBOOK_GHL_PASSWORD_RESET_WEBHOOK_URL=
# Booking link for the free setup call shown on /admin/welcome, /admin/funnels, /admin/plan and the home page (hidden when unset).
FORMBOOK_SETUP_CALL_URL=

# Plan page (Sprint 4). All hidden when unset.
# Checkout page for the Scaling plan (GoHighLevel order form). The app adds ?ref=<account reference> and nothing else.
FORMBOOK_UPGRADE_URL=
# Billing portal where Scaling customers update their card, see invoices or cancel. Linked as is.
FORMBOOK_BILLING_PORTAL_URL=

# Account lifecycle events sent to the owner's CRM (GoHighLevel inbound webhook). Both required to send.
# The secret signs each request (X-FormBook-Signature, HMAC-SHA256). Printable, 24 to 200 characters.
FORMBOOK_LIFECYCLE_WEBHOOK_URL=
FORMBOOK_LIFECYCLE_WEBHOOK_SECRET=

# Public product page: link to the walkthrough video (hidden when unset).
FORMBOOK_DEMO_VIDEO_URL=

# Cloudflare Turnstile on /signup. Required in production: without both keys signup is refused.
# Locally (NODE_ENV not production) the captcha is off when they are empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Platform owners who can open /admin/clients (comma or space separated).
FORMBOOK_OWNER_EMAILS=owner@example.com

# Protects the cron routes /api/cron/meta-events (Meta event queue) and /api/cron/crm-events
# (CRM delivery queue and account lifecycle events). Vercel sends it as a Bearer token. Random, 32+ characters.
CRON_SECRET=

# Google Calendar connections (Google Cloud OAuth client, type Web application).
# Scopes requested: openid, email, calendar.freebusy, calendar.events.owned.
# Authorised redirect URIs:
#   https://app.formbook.ca/api/connect/google/callback
#   https://formbooking.gondaltech.app/api/connect/google/callback (only if that optional extra address is used)
# When either value is empty the Connect Google Calendar button is hidden.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Extra app addresses allowed to start Google sign-ins, besides NEXT_PUBLIC_APP_URL
# (comma separated origins, no trailing slash). Optional. Example: https://formbooking.gondaltech.app
FORMBOOK_EXTRA_APP_ORIGINS=

# Calendly, Cal.com, HubSpot and webhook connections need no app-level settings: each customer
# pastes their own token, and webhook signing secrets are set per connection. Calendly booking
# notifications are sent to NEXT_PUBLIC_APP_URL, so set it to the final https address first.

# Public contact address. Shown on the product, legal, plan and signup pages and in account messages
# (falls back to the built-in address when empty), and on /help/connections (hidden there when empty).
# Redeploy after changing it.
FORMBOOK_SUPPORT_EMAIL=
